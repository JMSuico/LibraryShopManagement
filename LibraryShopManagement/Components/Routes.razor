@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(LibraryShopManagement.Components.Layout.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(LibraryShopManagement.Components.Layout.EmptyLayout)">
            <MudContainer MaxWidth="MaxWidth.Medium" Class="py-12">
                <MudPaper Class="pa-8 rounded-lg" Elevation="2">
                    <MudText Typo="Typo.h4" Color="Color.Primary" GutterBottom="true">Page not found</MudText>
                    <MudText Typo="Typo.body1" Class="mb-4">The page you requested does not exist.</MudText>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Go home</MudButton>
                </MudPaper>
            </MudContainer>
        </LayoutView>
    </NotFound>
</Router>
