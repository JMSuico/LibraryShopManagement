@page "/user-management"
@using System.Collections.Generic
@using System.Threading.Tasks
@using BlazorApp.Features.Data.Enums
@using BlazorApp.Features.Data.Models
@using BlazorApp.Features.Services.Interfaces
@inject IUserService UserService
@inject ISnackbar Snackbar
@layout LibraryShopManagement.Components.Layout.MainLayout

<MudPaper Class="pa-5 rounded-lg" Elevation="1">
    <MudTable T="User" Items="users" Dense="true" Hover="true" Bordered="true" Striped="true">
        <ToolBarContent>
            <MudText Typo="Typo.h5" Color="Color.Primary">Users</MudText>
            <MudSpacer />
            <MudButton OnClick="OpenAddUserDialog" Variant="Variant.Filled" Color="Color.Primary">Add User</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Username</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Username">@context.Username</MudTd>
            <MudTd DataLabel="Role">@context.Role</MudTd>
            <MudTd DataLabel="Actions">
                <div class="d-flex gap-2 flex-wrap">
                    <MudButton OnClick="@(() => OpenEditUserDialog(context))" Variant="Variant.Text" Color="Color.Primary">Edit</MudButton>
                    <MudButton OnClick="@(() => OpenDeleteDialog(context))" Variant="Variant.Text" Color="Color.Error">Delete</MudButton>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4">No users found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, int.MaxValue }"
                           RowsPerPageString="Rows per page"
                           InfoFormat="{first_item}-{last_item} of {all_items}"
                           AllItemsText="All" />
        </PagerContent>
    </MudTable>
</MudPaper>

<MudDialog @bind-Visible="isUserDialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(isEditMode ? "Edit User" : "Add User")</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="pa-2" Elevation="0">
            <MudTextField T="string" @bind-Value="editUser.Username" Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <MudTextField T="string" @bind-Value="editUser.Password" Label="Password" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <MudSelect T="UserRole" @bind-Value="editUser.Role" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="UserRole" Value="@(UserRole.Admin)">Admin</MudSelectItem>
                <MudSelectItem T="UserRole" Value="@(UserRole.Staff)">Staff</MudSelectItem>
                <MudSelectItem T="UserRole" Value="@(UserRole.Customer)">Customer</MudSelectItem>
            </MudSelect>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseUserDialog" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="SaveUserAsync" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isDeleteDialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete User</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="pa-2" Elevation="0">
            <MudText Typo="Typo.body1">This action cannot be undone. Do you want to proceed?</MudText>
            @if (userPendingDelete is not null)
            {
                <MudText Typo="Typo.body2" Class="mt-3">User: @userPendingDelete.Username</MudText>
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDeleteDialog" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="DeleteUserAsync" Variant="Variant.Filled" Color="Color.Error">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };
    private List<User> users = new();
    private User editUser = new() { Role = UserRole.Customer };
    private User? userPendingDelete;
    private bool isEditMode;
    private bool isUserDialogVisible;
    private bool isDeleteDialogVisible;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await UserService.GetUsersAsync();
    }

    private void OpenAddUserDialog()
    {
        ResetForm();
        isUserDialogVisible = true;
    }

    private void OpenEditUserDialog(User user)
    {
        editUser = new User
        {
            Id = user.Id,
            Username = user.Username,
            Password = user.Password,
            Role = user.Role
        };
        isEditMode = true;
        isUserDialogVisible = true;
    }

    private void OpenDeleteDialog(User user)
    {
        userPendingDelete = user;
        isDeleteDialogVisible = true;
    }

    private async Task SaveUserAsync()
    {
        if (string.IsNullOrWhiteSpace(editUser.Username) || string.IsNullOrWhiteSpace(editUser.Password))
        {
            Snackbar.Add("Username and password are required.", Severity.Error);
            return;
        }

        if (isEditMode)
        {
            await UserService.UpdateUserAsync(editUser);
            Snackbar.Add("User updated successfully.", Severity.Success);
        }
        else
        {
            await UserService.CreateUserAsync(new User
            {
                Username = editUser.Username,
                Password = editUser.Password,
                Role = editUser.Role
            });
            Snackbar.Add("User added successfully.", Severity.Success);
        }

        CloseUserDialog();
        await LoadUsersAsync();
    }

    private async Task DeleteUserAsync()
    {
        if (userPendingDelete is null)
        {
            return;
        }

        await UserService.DeleteUserAsync(userPendingDelete.Id);
        Snackbar.Add("User deleted successfully.", Severity.Success);
        CloseDeleteDialog();
        await LoadUsersAsync();
    }

    private void CloseUserDialog()
    {
        isUserDialogVisible = false;
        ResetForm();
    }

    private void CloseDeleteDialog()
    {
        isDeleteDialogVisible = false;
        userPendingDelete = null;
    }

    private void ResetForm()
    {
        editUser = new User { Role = UserRole.Customer };
        isEditMode = false;
    }
}
